# macOS 系统垃圾文件
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 打包产物与临时文件
dist/*
!dist/.gitkeep

# 核心二进制 (大文件防误传，请用户本地放入 bin/)
bin/*
!bin/.gitkeep
!bin/README.md

# 运行日志
*.log
app_backend.log

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# 编辑器配置
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 临时打包工作区
/tmp/narrafork_dmg_staging
